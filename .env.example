# InternsHub Frontend Environment Variables
#
# Copy this file to `.env.local` (ignored by Git via `*.local`), uncomment the values
# you need, and restart `npm run dev`.
#
# IMPORTANT:
# Every `VITE_*` variable is embedded into the client bundle and is publicly visible.
# Never store secrets, private keys, or credentials in `VITE_*` variables.

# -----------------------------------------------------------------------------------------------
# VITE_API_BASE_URL (optional — leave unset until the new backend is ready)
# Base origin of the future InternsHub backend API (without trailing slash or /api).
# Example:
# VITE_API_BASE_URL=https://api.example.com

# -----------------------------------------------------------------------------------------------
# API_PROXY_TARGET (optional — local dev only, never bundled)
# If you run a local backend and want Vite to proxy `/api/*` requests during `npm run dev`,
# set API_PROXY_TARGET here (without a VITE_ prefix).
# Note: Setting API_PROXY_TARGET automatically disables VITE_DEV_BYPASS_AUTH so proxy-based
# local backend testing always exercises real auth and role guards.
# Example:
# API_PROXY_TARGET=http://localhost:5000

# -----------------------------------------------------------------------------------------------
# VITE_APP_ENV (optional)
# Runtime environment label: development | staging | production
VITE_APP_ENV=development

# -----------------------------------------------------------------------------------------------
# VITE_DEV_BYPASS_AUTH (optional — explicit opt-in for local UI development ONLY)
# DISABLED BY DEFAULT.
# Uncomment `VITE_DEV_BYPASS_AUTH=true` in your local `.env.local` ONLY when you want to preview
# protected routes locally while no backend (`VITE_API_BASE_URL` or `API_PROXY_TARGET`) is wired.
# Any other value (missing, empty, `false`) keeps route guards strictly enforced.
# This flag is ALWAYS stripped and impossible to activate in production builds.
# VITE_DEV_BYPASS_AUTH=true
